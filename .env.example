# Local development database. Keep DATABASE_URL consistent with these values.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev
POSTGRES_DB=agentic_rag
POSTGRES_PORT=55432
DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:55432/agentic_rag
MODEL_CACHE_DIR=.cache/embeddings

# Local by default. Other choices: huggingface or openai.
# Set both provider and model when switching. Restart the API after changes.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096

# Required only when LLM_PROVIDER=openai. Keep the real key in .env.
OPENAI_API_KEY=

# Required only when LLM_PROVIDER=huggingface. Needs inference permissions/credits.
HF_TOKEN=

# Used only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Docker overrides. The host DATABASE_URL above is not used inside Compose.
API_PORT=8000
# DOCKER_DATABASE_URL=postgresql://rag:rag_local_dev@postgres:5432/agentic_rag
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# TLS_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem  # Only with compose.ca.yaml
